# Read by docker-compose.yml. Copy to .env and adjust.
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
POSTGRES_PORT=5432

# The chat page needs one model provider.
#
# Claude (the default). Needs credit on the Anthropic account:
ANTHROPIC_API_KEY=
#
# Or Google Gemini, which has a free tier (key from https://aistudio.google.com/apikey):
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODELS=gemini-flash-latest,gemini-3.5-flash,gemini-flash-lite-latest

# The chat's assistant is a council: up to 12 agents on different services answer
# each question in parallel and one model merges their best points. Every service
# below with a key joins it (all have free tiers); Pollinations and AI Horde need none.
# GROQ_API_KEY=            # https://console.groq.com/keys  (fast; its compound models search the web)
# OPENROUTER_API_KEY=      # https://openrouter.ai/keys     (every free model in its catalogue)
# MISTRAL_API_KEY=         # https://console.mistral.ai/api-keys
# CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
# GITHUB_MODELS_TOKEN=     # https://github.com/settings/tokens (fine-grained, "Models" read)
# CLOUDFLARE_ACCOUNT_ID=   # https://dash.cloudflare.com → Workers AI (text and FLUX pictures)
# CLOUDFLARE_API_TOKEN=
# HUGGINGFACE_API_KEY=     # https://huggingface.co/settings/tokens (text and FLUX pictures)
# SAMBANOVA_API_KEY=       # https://cloud.sambanova.ai  (now needs a payment method on file)
# Web search before every answer: Google News and Wikipedia need no key; these add
# whole-web results.
# TAVILY_API_KEY=          # https://app.tavily.com  (1,000 free searches a month, no card)
# BRAVE_API_KEY=           # https://brave.com/search/api
# DEEPSEEK_API_KEY=        # https://platform.deepseek.com/api_keys  (paid, a few cents a day)
# NVIDIA_API_KEY=          # https://build.nvidia.com
# COHERE_API_KEY=          # https://dashboard.cohere.com/api-keys
# TOGETHER_API_KEY=        # https://api.together.ai  (also free FLUX pictures)
# Pictures: a free AI Horde key (https://aihorde.net/register) moves its picture agents up
# the volunteers' queue; Gemini's image model needs a key with billing.
# HORDE_API_KEY=
# GEMINI_IMAGES=true
# ASSISTANT_COUNCIL_SIZE=12   # 1 turns the council off: one model answers

# Only for ingesting private repositories:
# GITHUB_TOKEN=
# API_PORT=8000
# WEB_PORT=3000

# Pictures the chat draws come from Pollinations (free, no key). Another service that
# draws from a URL can be used instead; {prompt} and {seed} are filled in.
# IMAGE_URL_TEMPLATE=https://image.pollinations.ai/prompt/{prompt}?width=1024&height=1024&seed={seed}&model=flux&nologo=true
