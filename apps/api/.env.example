# Copy to .env
DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
CORS_ORIGINS=["http://localhost:3000"]

# /ask needs one model provider.
# Claude (the default):
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# Or Google Gemini, which has a free tier:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# Requests per client IP per minute; 0 disables.
# RATE_LIMIT_PER_MINUTE=60
# ASK_RATE_LIMIT_PER_MINUTE=10
# INGEST_RATE_LIMIT_PER_MINUTE=5

# Only needed to ingest private repositories.
# GITHUB_TOKEN=
