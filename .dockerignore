# Build context is the repo root for every image.
.git
.github
infra
docker

**/.venv
**/__pycache__
**/*.egg-info
**/.pytest_cache
**/.ruff_cache

**/node_modules
**/.next
**/test-results
**/playwright-report

# Never bake local configuration or credentials into an image.
**/.env
**/.env.*
!**/.env.example
